# Public, write-only PostHog project configuration.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional. Without a model key the product runs the rule-based agent (no AI call, $0).

# Option A: OpenAI (default). MODEL defaults to gpt-5-mini, FALLBACK_MODEL to gpt-4.1-mini.
OPENAI_API_KEY=
MODEL=gpt-5-mini
FALLBACK_MODEL=gpt-4.1-mini

# Option B: any OpenAI-compatible endpoint (OpenRouter, Groq, Gemini's OpenAI endpoint, vLLM, Ollama).
# Takes precedence over Option A when both LLM_BASE_URL and LLM_API_KEY are set. MODEL is required.
# Check each provider's free-tier rate limits and data-use terms before sending real workflows.
LLM_BASE_URL=
LLM_API_KEY=

# Hard cap on live-model requests per function instance per day.
LIVE_DAILY_REQUEST_LIMIT=300
